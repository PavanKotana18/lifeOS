+-
+-      function renderPlannerTasksList(tasks, todayStr) {
+-        const list = document.getElementById('planner-tasks-container');
+-        if (!list) return;
+-
+-        if (state.plannerSubtab === 'weekly') {
+-          const daysOfWeek = [];
+-          const now = new Date();
+-          const currentDayOfWeek = now.getDay();
+-          const mondayOffset = currentDayOfWeek === 0 ? -6 : 1 - currentDayOfWeek;
+-          const monday = new Date(now);
+-          monday.setDate(now.getDate() + mondayOffset);
+-
+-          for (let i = 0; i < 7; i++) {
+-            const d = new Date(monday);
+-            d.setDate(monday.getDate() + i);
+-            const dStr = d.toISOString().split('T')[0];
+-            const dLabel = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
+-            daysOfWeek.push({ dStr, dLabel, isToday: dStr === todayStr });
+-          }
+-
+-          list.innerHTML = `
+-            <div>
+-              ${daysOfWeek.map(day => {
+-                const dayTasks = tasks.filter(t => t.dueDate === day.dStr);
+-                return `
+-                  <div class="card" style="margin-bottom: 10px; border-left: 4px solid ${day.isToday ? 'var(--primary)' : 'var(--border-color)'};">
+-                    <div class="card-title" style="margin-bottom: 8px;">
+-                      <span style="font-size: 13px; font-weight: 700; color: ${day.isToday ? 'var(--primary)' : 'var(--text-main)'};">${day.dLabel} ${day.isToday ? '(Today)' : ''}</span>
+-                      <span style="font-size: 11px; color: var(--text-dim);">${dayTasks.length} task(s)</span>
+-                    </div>
+-                    ${dayTasks.length === 0 ? `<p style="font-size: 12px; color: var(--text-dim);">No tasks scheduled</p>` : `
+-                      <div>
+-                        ${dayTasks.map(t => renderTaskRowHtml(t, todayStr)).join('')}
+-                      </div>
+-                    `}
+-                  </div>
+-                `;
+-              }).join('')}
+-            </div>
+-          `;
+-          attachTaskEventListeners(list, tasks);
+-          return;
+-        }
+-
+-        let filtered = tasks.slice();
+-        if (state.plannerFilter === 'overdue') {
+-          filtered = filtered.filter(t => !t.completed && t.dueDate && t.dueDate < todayStr);
+-        } else if (state.plannerSubtab === 'agenda') {
+-          filtered = filtered.filter(t => t.dueDate === todayStr || (!t.dueDate && !t.completed));
+-        }
+-
+-        filtered.sort((a, b) => {
+-          if (a.completed !== b.completed) return a.completed ? 1 : -1;
+-          const pOrder = { 'Urgent': 1, 'High': 2, 'Medium': 3, 'Low': 4 };
+-          return (pOrder[a.priority] || 3) - (pOrder[b.priority] || 3);
+-        });
+-
+-        if (filtered.length === 0) {
+-          list.innerHTML = `<div class="card empty-state"><p style="font-size: 13px;">No tasks found.</p></div>`;
+-          return;
+-        }
+-
+-        list.innerHTML = filtered.map(t => renderTaskRowHtml(t, todayStr)).join('');
+-        attachTaskEventListeners(list, tasks);
+-      }
+-
+-      function renderTaskRowHtml(t, todayStr) {
+-        const isOverdue = !t.completed && t.dueDate && t.dueDate < todayStr;
+-        return `
+-          <div class="item-row" style="background: var(--bg-surface); border: 1px solid var(--border-color); margin-bottom: 8px;">
+-            <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
+-              <input type="checkbox" class="task-chk" data-id="${t.id}" ${t.completed ? 'checked' : ''} style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--primary);">
+-              <div style="flex: 1;">
+-                <p style="font-size: 14px; font-weight: 600; text-decoration: ${t.completed ? 'line-through' : 'none'}; color: ${t.completed ? 'var(--text-muted)' : 'var(--text-main)'};">${escapeHtml(t.title)}</p>
+-                <div style="display: flex; align-items: center; gap: 6px; margin-top: 4px; font-size: 11px;">
+-                  <span class="badge ${t.priority === 'Urgent' ? 'badge-danger' : t.priority === 'High' ? 'badge-warning' : 'badge-neutral'}" style="font-size: 9px;">${t.priority}</span>
+-                  <span style="color: ${isOverdue ? 'var(--danger)' : 'var(--text-dim)'}; font-weight: ${isOverdue ? '700' : 'normal'};">
+-                    📅 ${formatDate(t.dueDate) || 'No date'}
+-                  </span>
+-                  ${t.recurring && t.recurring !== 'None' ? `<span class="badge badge-primary" style="font-size: 9px;">🔁 ${t.recurring}</span>` : ''}
+-                  ${t.category ? `<span class="badge badge-neutral" style="font-size: 9px;">${escapeHtml(t.category)}</span>` : ''}
+-                </div>
+-                ${t.notes ? `<p style="font-size: 11px; color: var(--text-dim); margin-top: 4px;">${escapeHtml(t.notes)}</p>` : ''}
+-              </div>
+-            </div>
+-            <div style="display: flex; gap: 4px;">
+-              <button class="btn-icon btn-sm btn-edit-task" data-id="${t.id}" aria-label="Edit Task">
+-                <svg class="icon" style="width:14px;height:14px;" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
+-              </button>
