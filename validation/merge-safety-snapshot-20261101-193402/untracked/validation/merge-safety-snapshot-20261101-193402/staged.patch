+-            ...existing,
+-            completed: completedState,
+-            completedAt: completedState ? new Date().toISOString() : null
+-          });
+-        } else {
+-          await db.put('habitLogs', {
+-            habitId,
+-            date: dateStr,
+-            completed: completedState,
+-            completedAt: new Date().toISOString()
+-          });
+-        }
+-        showToast(completedState ? 'Habit completed! 🔥' : 'Habit undone', 'success');
+-      }
