+-
+-      async function toggleTaskCompletedWithRecurrence(task, completedState) {
+-        await db.put('tasks', {
+-          ...task,
+-          completed: completedState,
+-          completedAt: completedState ? new Date().toISOString() : null
+-        });
+-
+-        if (completedState && task.recurring && task.recurring !== 'None') {
+-          const nextDate = new Date(task.dueDate || new Date());
+-          if (task.recurring === 'Daily') nextDate.setDate(nextDate.getDate() + 1);
+-          else if (task.recurring === 'Weekly') nextDate.setDate(nextDate.getDate() + 7);
+-          else if (task.recurring === 'Monthly') nextDate.setMonth(nextDate.getMonth() + 1);
+-
+-          const yyyy = nextDate.getFullYear();
+-          const mm = String(nextDate.getMonth() + 1).padStart(2, '0');
+-          const dd = String(nextDate.getDate()).padStart(2, '0');
+-
+-          await db.put('tasks', {
+-            title: task.title,
+-            dueDate: `${yyyy}-${mm}-${dd}`,
+-            priority: task.priority,
+-            category: task.category,
+-            notes: task.notes,
+-            recurring: task.recurring,
+-            completed: false
+-          });
+-          showToast(`Completed! Next ${task.recurring.toLowerCase()} task scheduled for ${dd}/${mm}`, 'success');
+-        } else {
+-          showToast(completedState ? 'Task completed' : 'Task uncompleted', 'success');
+-        }
+-      }
