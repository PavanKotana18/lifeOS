+-            (t.description && t.description.toLowerCase().includes(q)) ||
+-            (t.category && t.category.toLowerCase().includes(q)) ||
+-            (t.notes && t.notes.toLowerCase().includes(q))
+-          );
+-        }
+-
+-        filtered.sort((a, b) => {
+-          if (state.financeSortBy === 'date-desc') return (b.date || '').localeCompare(a.date || '');
+-          if (state.financeSortBy === 'date-asc') return (a.date || '').localeCompare(b.date || '');
+-          if (state.financeSortBy === 'amount-desc') return (Number(b.amount) || 0) - (Number(a.amount) || 0);
+-          if (state.financeSortBy === 'amount-asc') return (Number(a.amount) || 0) - (Number(b.amount) || 0);
+-          return 0;
+-        });
