+-            <button class="btn-icon btn-sm" id="modal-close-btn">&times;</button>
+-          </div>
+-          <p style="font-size: 13px; color: var(--text-main); margin-bottom: 12px;">Type <strong>RESET</strong> to confirm wiping all on-device records.</p>
+-          <div class="form-group">
+-            <input type="text" id="confirm-reset-text" class="form-control" placeholder="RESET">
+-          </div>
+-          <button class="btn btn-danger" id="btn-execute-reset" style="width: 100%;">Erase All Data</button>
+-        `);
+-
+-        document.getElementById('modal-close-btn').addEventListener('click', closeModal);
+-        document.getElementById('btn-execute-reset').addEventListener('click', async () => {
+-          const txt = document.getElementById('confirm-reset-text').value.trim();
+-          if (txt === 'RESET') {
+-            await db.clearAll();
+-            closeModal();
+-            showToast('Application reset', 'info');
+-          } else {
+-            showToast('Confirmation text did not match', 'warning');
+-          }
+-        });
+-      }
+-
+-      // 5. APP CONTROLLER & NAVIGATION
+-      function switchTab(tabKey) {
+-        state.currentTab = tabKey;
+-        const views = document.querySelectorAll('.app-view');
+-        views.forEach(v => {
+-          v.style.display = v.id === `view-${tabKey}` ? 'block' : 'none';
+-        });
+-
+-        document.querySelectorAll('.nav-item').forEach(btn => {
+-          btn.classList.toggle('active', btn.dataset.tab === tabKey);
+-        });
+-
+-        const titles = {
+-          dashboard: 'LifeOS',
+-          finance: 'Finance Manager',
+-          habits: 'Habit Tracker',
+-          goals: 'Goal Tracker',
+-          planner: 'Daily Planner',
+-          settings: 'Settings'
+-        };
+-        const headerTitle = document.getElementById('header-title');
+-        if (headerTitle) headerTitle.innerText = titles[tabKey] || 'LifeOS';
+-
+-        renderCurrentView();
+-      }
+-
+-      async function renderCurrentView() {
+-        if (state.currentTab === 'dashboard') await renderDashboard();
+-        else if (state.currentTab === 'finance') await renderFinance();
+-        else if (state.currentTab === 'habits') await renderHabits();
+-        else if (state.currentTab === 'goals') await renderGoals();
+-        else if (state.currentTab === 'planner') await renderPlanner();
+-        else if (state.currentTab === 'settings') await renderSettings();
+-      }
+-
+-      function setTheme(theme) {
+-        state.theme = theme;
+-        if (theme === 'dark') {
+-          document.documentElement.classList.add('dark');
+-          document.documentElement.classList.remove('light');
+-        } else {
+-          document.documentElement.classList.add('light');
+-          document.documentElement.classList.remove('dark');
+-        }
+-        db.put('settings', { key: 'theme', value: theme });
+-      }
+-
+-      function bootstrap() {
+-        // Load initial settings synchronously from memory store
+-        const themeSet = db.tables.settings.get('theme');
+-        if (themeSet && themeSet.value) setTheme(themeSet.value);
+-
+-        const curSet = db.tables.settings.get('currency');
+-        if (curSet && curSet.value) state.currency = curSet.value;
+-
+-        const symSet = db.tables.settings.get('currencySymbol');
+-        if (symSet && symSet.value) state.currencySymbol = symSet.value;
+-
+-        db.subscribe(() => renderCurrentView());
+-
+-        document.querySelectorAll('.nav-item').forEach(btn => {
+-          btn.addEventListener('click', () => switchTab(btn.dataset.tab));
+-        });
+-
+-        document.getElementById('theme-toggle-btn')?.addEventListener('click', () => {
+-          setTheme(state.theme === 'dark' ? 'light' : 'dark');
+-        });
+-
+-        document.getElementById('fab-add')?.addEventListener('click', async () => {
+-          if (state.currentTab === 'finance') {
+-            const cats = await db.getAll('categories');
+-            openTransactionModal('expense', cats);
+-          } else if (state.currentTab === 'habits') {
+-            openHabitModal();
+-          } else if (state.currentTab === 'goals') {
+-            openGoalModal();
+-          } else if (state.currentTab === 'planner' || state.currentTab === 'dashboard') {
+-            openTaskModal();
+-          } else {
+-            const cats = await db.getAll('categories');
+-            openTransactionModal('expense', cats);
+-          }
+-        });
+-
+-        switchTab('dashboard');
+-      }
+-
+-      // Safe DOM ready check: if DOM is already ready, run immediately!
+-      if (document.readyState === 'loading') {
+-        document.addEventListener('DOMContentLoaded', bootstrap);
+-      } else {
+-        bootstrap();
+-      }
+-    })();
