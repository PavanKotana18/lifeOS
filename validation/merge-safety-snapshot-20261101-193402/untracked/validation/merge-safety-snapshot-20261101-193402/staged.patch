+-  <script>
+-    (function () {
+-      'use strict';
+-
+-      // 1. BULLETPROOF IN-MEMORY + PERSISTENT DATABASE ENGINE
+-      class ResilientLifeOSDB {
+-        constructor() {
+-          this.tables = {
+-            transactions: new Map(),
+-            categories: new Map(),
+-            budgets: new Map(),
+-            savingsGoals: new Map(),
+-            savingsContributions: new Map(),
+-            habits: new Map(),
+-            habitLogs: new Map(),
+-            goals: new Map(),
+-            milestones: new Map(),
+-            tasks: new Map(),
+-            settings: new Map()
+-          };
+-          this.subscribers = new Set();
+-          this.init();
+-        }
+-
+-        init() {
+-          // 1. Try to load saved state from localStorage safely
+-          try {
+-            if (typeof localStorage !== 'undefined') {
+-              for (const key of Object.keys(this.tables)) {
+-                const raw = localStorage.getItem('LifeOS_' + key);
+-                if (raw) {
+-                  const arr = JSON.parse(raw);
+-                  if (Array.isArray(arr)) {
+-                    for (const item of arr) {
+-                      const id = key === 'settings' ? item.key : item.id;
+-                      this.tables[key].set(id, item);
+-                    }
+-                  }
+-                }
+-              }
+-            }
+-          } catch (e) {
+-            console.warn('LocalStorage unavailable');
+-          }
+-
+-          // 2. Seed initial sample data if categories are empty
+-          this.seedDefaultsIfEmpty();
+-
+-          // 3. Proactively attempt IndexedDB without blocking or crashing
+-          try {
+-            if (typeof window !== 'undefined' && 'indexedDB' in window && window.indexedDB) {
+-              const req = window.indexedDB.open('LifeOS_Database', 2);
+-              req.onupgradeneeded = (e) => {
+-                const idb = e.target.result;
+-                Object.keys(this.tables).forEach(name => {
+-                  if (!idb.objectStoreNames.contains(name)) {
+-                    idb.createObjectStore(name, { keyPath: name === 'settings' ? 'key' : 'id' });
+-                  }
+-                });
+-              };
+-              req.onsuccess = (e) => {
+-                this.idb = e.target.result;
+-              };
+-            }
+-          } catch (e) {
+-            // Silently fall back to in-memory + localStorage
+-          }
+-        }
+-
+-        seedDefaultsIfEmpty() {
+-          if (this.tables.categories.size === 0) {
+-            const defaultCats = [
+-              { id: 'cat_sal', name: 'Salary', type: 'income', color: '#10b981', isDefault: true },
+-              { id: 'cat_free', name: 'Freelance', type: 'income', color: '#3b82f6', isDefault: true },
+-              { id: 'cat_int', name: 'Interest', type: 'income', color: '#8b5cf6', isDefault: true },
+-              { id: 'cat_oth_in', name: 'Other Income', type: 'income', color: '#06b6d4', isDefault: true },
+-              { id: 'cat_rent', name: 'Rent', type: 'expense', color: '#ef4444', isDefault: true },
+-              { id: 'cat_food', name: 'Food', type: 'expense', color: '#f59e0b', isDefault: true },
+-              { id: 'cat_trans', name: 'Transport', type: 'expense', color: '#6366f1', isDefault: true },
+-              { id: 'cat_shop', name: 'Shopping', type: 'expense', color: '#ec4899', isDefault: true },
+-              { id: 'cat_util', name: 'Utilities', type: 'expense', color: '#8b5cf6', isDefault: true },
+-              { id: 'cat_health', name: 'Health', type: 'expense', color: '#14b8a6', isDefault: true },
+-              { id: 'cat_ent', name: 'Entertainment', type: 'expense', color: '#a855f7', isDefault: true },
+-              { id: 'cat_edu', name: 'Education', type: 'expense', color: '#0284c7', isDefault: true },
+-              { id: 'cat_emi', name: 'EMIs', type: 'expense', color: '#f97316', isDefault: true },
+-              { id: 'cat_inv', name: 'Investments', type: 'expense', color: '#10b981', isDefault: true },
+-              { id: 'cat_oth_ex', name: 'Other Expenses', type: 'expense', color: '#64748b', isDefault: true }
+-            ];
+-            for (const c of defaultCats) this.tables.categories.set(c.id, c);
+-          }
+-
+-          // CLEAN FIRST LAUNCH:
+-          // Strictly seed categories and base settings only.
+-          // Zero demonstration records (no sample salary, rent, habits, goals or tasks) are injected automatically.
+-          // Optional demo data is accessible exclusively through a user-initiated action in Settings.
+-
+-          if (this.tables.settings.size === 0) {
+-            this.tables.settings.set('theme', { key: 'theme', value: 'dark' });
+-            this.tables.settings.set('currency', { key: 'currency', value: 'INR' });
+-            this.tables.settings.set('currencySymbol', { key: 'currencySymbol', value: '₹' });
+-            this.tables.settings.set('dateFormat', { key: 'dateFormat', value: 'DD/MM/YYYY' });
+-            this.tables.settings.set('monthlyBudget', { key: 'monthlyBudget', value: 65000 });
+-          }
+-        }
+-
+-        persistStore(storeName) {
+-          try {
+-            if (typeof localStorage !== 'undefined' && this.tables[storeName]) {
+-              localStorage.setItem('LifeOS_' + storeName, JSON.stringify(Array.from(this.tables[storeName].values())));
+-            }
+-          } catch (e) {}
+-
+-          // Also mirror to IndexedDB if connected
+-          if (this.idb) {
+-            try {
+-              const tx = this.idb.transaction(storeName, 'readwrite');
+-              const store = tx.objectStore(storeName);
+-              store.clear();
+-              for (const item of this.tables[storeName].values()) {
+-                store.put(item);
+-              }
+-            } catch (e) {}
+-          }
+-        }
+-
+-        async getAll(storeName) {
+-          const t = this.tables[storeName];
+-          if (!t) return [];
+-          return Array.from(t.values());
+-        }
+-
+-        async get(storeName, id) {
+-          const t = this.tables[storeName];
+-          if (!t) return null;
+-          return t.get(id) || null;
+-        }
+-
+-        async put(storeName, item) {
+-          if (!this.tables[storeName]) return item;
+-          if (!item.id && storeName !== 'settings') {
+-            item.id = 'id_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);
+-          }
+-          item.updatedAt = new Date().toISOString();
+-          if (!item.createdAt) item.createdAt = item.updatedAt;
+-
+-          const key = storeName === 'settings' ? item.key : item.id;
+-          this.tables[storeName].set(key, item);
+-          this.persistStore(storeName);
+-          this.notify();
+-          return item;
+-        }
+-
+-        async delete(storeName, id) {
+-          if (!this.tables[storeName]) return false;
+-          const res = this.tables[storeName].delete(id);
+-          this.persistStore(storeName);
+-          this.notify();
+-          return res;
+-        }
+-
+-        async clear(storeName) {
+-          if (this.tables[storeName]) {
+-            this.tables[storeName].clear();
+-            this.persistStore(storeName);
+-            this.notify();
+-          }
+-        }
+-
+-        seedDemoData() {
+-          const today = new Date().toISOString().split('T')[0];
+-          const curMonth = today.substring(0, 7);
+-
+-          // Sample Transactions
+-          this.tables.transactions.set('tx_d1', { id: 'tx_d1', type: 'income', amount: 95000, category: 'Salary', description: 'Tech Consultancy Salary', date: `${curMonth}-01`, paymentMethod: 'Bank Transfer', createdAt: new Date().toISOString() });
+-          this.tables.transactions.set('tx_d2', { id: 'tx_d2', type: 'income', amount: 15000, category: 'Freelance', description: 'Web Architecture Sprint', date: `${curMonth}-15`, paymentMethod: 'Net Banking', createdAt: new Date().toISOString() });
+-          this.tables.transactions.set('tx_d3', { id: 'tx_d3', type: 'expense', amount: 28000, category: 'Rent', description: 'Apartment Monthly Rent', date: `${curMonth}-02`, paymentMethod: 'UPI', createdAt: new Date().toISOString() });
+-          this.tables.transactions.set('tx_d4', { id: 'tx_d4', type: 'expense', amount: 6500, category: 'Food', description: 'Organic Pantry Provisions', date: `${curMonth}-08`, paymentMethod: 'Credit Card', createdAt: new Date().toISOString() });
+-          this.tables.transactions.set('tx_d5', { id: 'tx_d5', type: 'expense', amount: 2400, category: 'Utilities', description: 'Fiber Broadband & Power', date: `${curMonth}-12`, paymentMethod: 'UPI', createdAt: new Date().toISOString() });
+-
+-          // Sample Budget & Savings
+-          this.tables.budgets.set('b_d_overall', { id: 'b_d_overall', monthlyAmount: 60000, monthYear: curMonth, createdAt: new Date().toISOString() });
+-          this.tables.budgets.set('b_d_food', { id: 'b_d_food', categoryId: 'Food', monthlyAmount: 12000, monthYear: curMonth, createdAt: new Date().toISOString() });
+-          this.tables.savingsGoals.set('sg_d1', { id: 'sg_d1', title: 'Emergency Reserve Fund', targetAmount: 200000, currentAmount: 85000, targetDate: '2026-12-31', category: 'Financial', createdAt: new Date().toISOString() });
+-
+-          // Sample Habits
+-          this.tables.habits.set('h_d1', { id: 'h_d1', name: 'Drink 3L Water', frequency: 'daily', color: '#3b82f6', createdAt: new Date().toISOString() });
+-          this.tables.habits.set('h_d2', { id: 'h_d2', name: 'Walk 10,000 steps', frequency: 'daily', color: '#10b981', createdAt: new Date().toISOString() });
+-          this.tables.habits.set('h_d3', { id: 'h_d3', name: 'Read 20 pages', frequency: 'daily', color: '#8b5cf6', createdAt: new Date().toISOString() });
+-
+-          const yesterday = new Date(Date.now() - 86400000).toISOString().split('T')[0];
+-          this.tables.habitLogs.set('hl_d1', { id: 'hl_d1', habitId: 'h_d1', date: yesterday, completed: true, completedAt: new Date().toISOString() });
+-          this.tables.habitLogs.set('hl_d2', { id: 'hl_d2', habitId: 'h_d1', date: today, completed: true, completedAt: new Date().toISOString() });
+-          this.tables.habitLogs.set('hl_d3', { id: 'hl_d3', habitId: 'h_d2', date: yesterday, completed: true, completedAt: new Date().toISOString() });
+-
+-          // Sample Goals
+-          this.tables.goals.set('g_d1', { id: 'g_d1', title: 'Run Half Marathon (21.1 km)', description: 'State endurance marathon prep', category: 'Fitness', targetValue: 21.1, currentValue: 10.0, unit: 'km', startDate: '2026-09-01', targetDate: '2026-12-31', priority: 'High', status: 'In Progress', createdAt: new Date().toISOString() });
+-          this.tables.milestones.set('m_d1', { id: 'm_d1', goalId: 'g_d1', title: '5km continuous run', completed: true });
+-          this.tables.milestones.set('m_d2', { id: 'm_d2', goalId: 'g_d1', title: '10km non-stop run', completed: true });
+-          this.tables.milestones.set('m_d3', { id: 'm_d3', goalId: 'g_d1', title: '15km long trail run', completed: false });
+-
+-          // Sample Tasks
+-          this.tables.tasks.set('t_d1', { id: 't_d1', title: 'Quarterly financial audit & mutual fund rebalancing', dueDate: today, priority: 'Urgent', category: 'Finance', recurring: 'None', completed: false, createdAt: new Date().toISOString() });
+-          this.tables.tasks.set('t_d2', { id: 't_d2', title: '5km recovery jog at neighborhood track', dueDate: today, priority: 'Medium', category: 'Fitness', recurring: 'Daily', completed: true, createdAt: new Date().toISOString() });
+-          this.tables.tasks.set('t_d3', { id: 't_d3', title: 'Android 16 offline build verification', dueDate: today, priority: 'High', category: 'Career', recurring: 'None', completed: false, createdAt: new Date().toISOString() });
+-
+-          for (const key of Object.keys(this.tables)) this.persistStore(key);
+-          this.notify();
+-        }
+-
+-        async clearAll() {
+-          for (const key of Object.keys(this.tables)) {
+-            this.tables[key].clear();
+-            this.persistStore(key);
+-          }
+-          this.seedDefaultsIfEmpty();
+-          for (const key of Object.keys(this.tables)) {
+-            this.persistStore(key);
+-          }
+-          this.notify();
+-        }
+-
+-        async exportAllData() {
+-          const exportObj = {
+-            version: '1.0.0',
+-            exportedAt: new Date().toISOString(),
+-            appName: 'LifeOS',
+-            tables: {}
+-          };
+-          for (const [key, map] of Object.entries(this.tables)) {
+-            exportObj.tables[key] = Array.from(map.values());
+-          }
+-          return exportObj;
+-        }
+-
+-        async importAllData(imported) {
+-          if (!imported || !imported.tables) {
+-            throw new Error('Invalid LifeOS backup file: missing tables data');
+-          }
+-          for (const [storeName, records] of Object.entries(imported.tables)) {
+-            if (this.tables[storeName] && Array.isArray(records)) {
+-              this.tables[storeName].clear();
+-              for (const item of records) {
+-                const id = storeName === 'settings' ? item.key : item.id;
+-                this.tables[storeName].set(id, item);
+-              }
+-              this.persistStore(storeName);
+-            }
+-          }
+-          this.notify();
+-          return true;
+-        }
+-
+-        subscribe(callback) {
+-          this.subscribers.add(callback);
+-          return () => this.subscribers.delete(callback);
+-        }
+-
+-        notify() {
+-          for (const cb of this.subscribers) {
+-            try { cb(); } catch (e) { console.error(e); }
+-          }
+-        }
+-      }
+-
+-      const db = new ResilientLifeOSDB();
+-      window.LifeOS_DB = db;
+-
+-      // 2. STATE AND HELPERS
+-      const state = {
+-        currentTab: 'dashboard',
+-        financeSubtab: 'overview',
+-        financeFilterType: 'all',
+-        financeFilterCategory: 'all',
+-        financeFilterMonth: new Date().toISOString().substring(0, 7),
+-        financeSearchQuery: '',
+-        financeSortBy: 'date-desc',
+-        habitsSubtab: 'checklist',
+-        habitsSelectedDate: new Date().toISOString().split('T')[0],
+-        goalsSubtab: 'active',
+-        goalsCategoryFilter: 'all',
+-        plannerSubtab: 'agenda',
+-        plannerFilter: 'all',
+-        currency: 'INR',
+-        currencySymbol: '₹',
+-        theme: 'dark'
+-      };
+-
+-      function formatMoney(amount) {
+-        const num = Number(amount) || 0;
+-        const sym = state.currencySymbol || '₹';
+-        if (state.currency === 'INR') {
+-          return sym + num.toLocaleString('en-IN', { maximumFractionDigits: 0 });
+-        }
+-        return sym + num.toLocaleString('en-US', { maximumFractionDigits: 0 });
+-      }
+-
+-      function formatDate(dateStr) {
+-        if (!dateStr) return '';
+-        const parts = dateStr.split('-');
+-        if (parts.length !== 3) return dateStr;
+-        return `${parts[2]}/${parts[1]}/${parts[0]}`;
+-      }
+-
+-      function getDaysRemainingText(targetDateStr) {
+-        if (!targetDateStr) return '';
+-        const today = new Date(new Date().toISOString().split('T')[0] + 'T00:00:00');
+-        const target = new Date(targetDateStr + 'T00:00:00');
+-        const diffDays = Math.round((target - today) / (1000 * 60 * 60 * 24));
+-        if (diffDays === 0) return 'Due today';
+-        if (diffDays > 0) return `${diffDays} day${diffDays === 1 ? '' : 's'} remaining`;
+-        return `Overdue by ${Math.abs(diffDays)} day${Math.abs(diffDays) === 1 ? '' : 's'}`;
+-      }
+-
+-      function showToast(message, type = 'info') {
+-        const container = document.getElementById('toast-container');
+-        if (!container) return;
+-        const toast = document.createElement('div');
+-        toast.className = 'toast';
+-        const color = type === 'success' ? '#10b981' : type === 'danger' ? '#ef4444' : '#6366f1';
